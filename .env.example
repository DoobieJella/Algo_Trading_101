# Korea Investment & Securities (KIS) API Credentials
# Get these from https://apiportal.koreainvestment.com/
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# Account No (Can be found in MTS/HTS)
KIS_ACCOUNT_NO=your_account_number

# CANO (Account first 8 digits) + ACQE (Account last 2 digits, usually 01)
KIS_CANO=12345678
KIS_ACQE=01

# Trading mode for bot execution: REAL or MOCK (default: MOCK)
TRADING_MODE=MOCK

# Read-only KIS data access for probes/downloads: MOCK, VIRTUAL, or REAL
# Use VIRTUAL first when verifying accessible market-data endpoints.
KIS_API_ENV=VIRTUAL

# Optional runtime controls
BOT_POLL_INTERVAL_SECONDS=2
BOT_MAX_TICKS=
